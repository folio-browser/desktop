 /* static */
+// Folio: its own block lists also apply to first-party subresources (never the document itself).
+// Firefox 161 renamed IsThirdPartyUnlessAnnotating to ShouldClassifyForETP and added AddonMayLoad: kept for both paths.
+bool ContentClassifierFeatureUtils::IsFolioBlockable(
+    const ContentClassifierRequest& aRequest, ClassifyMode aMode) {
+  if (ShouldClassifyForETP(aRequest, aMode)) {
+    return true;
+  }
+  return StaticPrefs::privacy_trackingprotection_content_folio_first_party() &&
+         !aRequest.AddonMayLoad() &&
+         !aRequest.RequestType().EqualsLiteral("document");
+}
