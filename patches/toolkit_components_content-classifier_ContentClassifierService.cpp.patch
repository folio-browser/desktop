+void ContentClassifierService::MaybeLoadFolioLists() {
+  if (!sEnabled) {
+    return;
+  }
+  nsAutoCString urls;
+  Preferences::GetCString(
+      "privacy.trackingprotection.content.protection.test_list_urls", urls);
+  if (urls.IsEmpty()) {
+    return;
+  }
+  nsTArray<nsCString> updated;
+  updated.AppendElement("test_block"_ns);
+  ProcessListChanges(updated, {});
+}
