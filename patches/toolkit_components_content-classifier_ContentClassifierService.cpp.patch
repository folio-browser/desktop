+// ---- Folio: cosmetic filtering for the built-in ad blocker (2026-11-24) ----
+// Sync on the main thread, under mLock like every engine call (the engine's
+// regex cache is not thread-safe; the lock serializes it with classification).
+
+NS_IMETHODIMP ContentClassifierService::FolioCosmetic(const nsACString& aUrl,
+                                                      nsACString& aHide,
+                                                      nsACString& aExceptions,
+                                                      nsACString& aScript,
+                                                      bool* aGenerichide) {
+  NS_ENSURE_ARG_POINTER(aGenerichide);
+  *aGenerichide = false;
+  if (!IsInitialized()) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  MutexAutoLock lock(mLock);
+  auto entry = mEngines.Lookup("test_block"_ns);
+  if (!entry || !entry.Data()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  return entry.Data()->CosmeticResources(aUrl, aHide, aExceptions, aScript,
+                                         aGenerichide);
+}
+
+NS_IMETHODIMP ContentClassifierService::FolioClassIdSelectors(
+    const nsACString& aClasses, const nsACString& aIds,
+    const nsACString& aExceptions, nsACString& aSelectors) {
+  if (!IsInitialized()) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  MutexAutoLock lock(mLock);
+  auto entry = mEngines.Lookup("test_block"_ns);
+  if (!entry || !entry.Data()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  return entry.Data()->ClassIdSelectors(aClasses, aIds, aExceptions,
+                                        aSelectors);
+}
