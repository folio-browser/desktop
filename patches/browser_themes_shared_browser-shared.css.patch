--- a/browser/themes/shared/browser-shared.css
+++ b/browser/themes/shared/browser-shared.css
@@ -1791,3 +1791,1793 @@
 #bookmarksToolbarFolderMenu {
   --menuitem-icon: url("chrome://browser/skin/places/bookmarksToolbar.svg");
 }
+
+/* ---- Folio: Arc-style window ---------------------------------------------------- */
+/* No close / minimize / maximize buttons on a tiling window manager (it handles windows). On floating desktops they
+   stay: Folio draws its own title bar there, so they are the only way to close or maximize. (folio-tiling: folio-sidebar.js) */
+:root[folio-tiling] .titlebar-buttonbox-container,
+:root[folio-tiling] .titlebar-spacer { display: none !important; }
+:root:not([folio-tiling]) .titlebar-spacer { display: none !important; }
+
+:root {
+  --folio-frame: #131216;
+  --folio-accent: #ce5caa;
+}
+/* One quiet frame color around everything: toolbar, sidebar and the gaps. */
+#navigator-toolbox,
+#nav-bar,
+#browser,
+#sidebar-main,
+#sidebar-box { background-color: var(--folio-frame) !important; }
+#nav-bar { border: none !important; box-shadow: none !important; }
+#navigator-toolbox { border-bottom: none !important; }
+
+/* The page is a card floating in the frame. */
+#tabbrowser-tabbox {
+  margin: 0 8px 8px 2px;
+  border-radius: 12px;
+  overflow: clip;
+  outline: 1px solid rgb(var(--folio-ink, 255 255 255) / 0.06);
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
+}
+
+/* Address bar: quieter, rounder. */
+#urlbar-background { border-radius: 10px !important; border-color: transparent !important; }
+#urlbar[focused] > #urlbar-background { outline: 1px solid var(--folio-accent) !important; }
+
+/* Vertical tabs: roomy rows, the selected one gets the accent edge. */
+#tabbrowser-tabs[orient="vertical"] .tab-background { border-radius: 10px !important; }
+#tabbrowser-tabs[orient="vertical"] .tabbrowser-tab[selected] .tab-background {
+  box-shadow: inset 2px 0 0 var(--folio-accent) !important;
+}
+
+/* ---- Folio: element switches. Each one is a pref; the Appearance page flips them. ---- */
+@media -moz-pref("folio.hide.back") { #back-button { display: none !important; } }
+@media -moz-pref("folio.hide.forward") { #forward-button { display: none !important; } }
+@media -moz-pref("folio.hide.reload") { #stop-reload-button, #reload-button, #stop-button { display: none !important; } }
+@media -moz-pref("folio.hide.home") { #home-button { display: none !important; } }
+@media -moz-pref("folio.hide.sidebarbtn") { #sidebar-button { display: none !important; } }
+@media -moz-pref("folio.hide.alltabs") { #alltabs-button { display: none !important; } }
+@media -moz-pref("folio.hide.extensions") { #unified-extensions-button { display: none !important; } }
+@media -moz-pref("folio.hide.menu") { #PanelUI-menu-button { display: none !important; } }
+@media -moz-pref("folio.hide.engine") { #urlbar-searchmode-switcher { display: none !important; } }
+@media -moz-pref("folio.hide.shield") { #tracking-protection-icon-container { display: none !important; } }
+@media -moz-pref("folio.hide.siteinfo") { #identity-box { display: none !important; } }
+@media -moz-pref("folio.hide.star") { #star-button-box { display: none !important; } }
+@media -moz-pref("folio.hide.tabclose") { .tabbrowser-tab .tab-close-button { display: none !important; } }
+@media -moz-pref("folio.hide.newtab") { #vertical-tabs-newtab-button, #tabs-newtab-button, #new-tab-button { display: none !important; } }
+@media -moz-pref("folio.hide.shadow") { #tabbrowser-tabbox { box-shadow: none !important; } }
+@media -moz-pref("folio.hide.outline") { #tabbrowser-tabbox { outline: none !important; } }
+@media -moz-pref("folio.hide.gaps") { #tabbrowser-tabbox { margin: 0 !important; border-radius: 0 !important; } }
+
+/* ---- Folio: drag toolbar buttons anytime ---- */
+.folio-dragging { opacity: 0.25 !important; }
+.folio-drag-ghost {
+  position: fixed !important; z-index: 2147483647; pointer-events: none !important; margin: 0 !important;
+  display: flex; align-items: center; justify-content: center;
+  border-radius: 8px; background: rgba(40, 38, 44, 0.95);
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45); scale: 1.08;
+  transition: opacity 0.15s ease, scale 0.15s ease;
+}
+.folio-drag-ghost[removing] { opacity: 0.45; scale: 0.9; outline: 1px dashed var(--folio-accent); }
+.folio-drag-marker {
+  position: fixed; z-index: 2147483646; width: 2px; border-radius: 1px; pointer-events: none;
+  background: var(--folio-accent);
+}
+:root[folio-dragging] { cursor: grabbing; }
+.folio-toast {
+  position: fixed; z-index: 2147483647; left: 50%; bottom: 28px; translate: -50% 0;
+  display: flex; align-items: center; gap: 16px; padding: 10px 12px 10px 18px;
+  border-radius: 14px; background: var(--folio-panel-bg, #24222a); color: var(--folio-text, #f2eee8); font: menu; font-size: 14px;
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
+}
+.folio-toast button {
+  border: none; border-radius: 10px; padding: 6px 14px; cursor: pointer;
+  background: var(--folio-accent); color: #fff; font: inherit; font-weight: 600;
+}
+
+/* ---- Folio: toolbar at the bottom (drag the address bar to the bottom edge) ---- */
+@media -moz-pref("folio.toolbar.bottom") {
+  #navigator-toolbox { order: 1; }
+  #tabbrowser-tabbox { margin: 8px 8px 0 2px; }
+}
+/* While dragging, the toolbar you can drop on glows faintly. */
+[folio-drop-target] { box-shadow: inset 0 0 0 1px rgba(206, 92, 170, 0.5) !important; border-radius: 10px; }
+
+/* ---- Folio: toolbar at the top of the sidebar (Zen / Vivaldi layout) ---- */
+/* The toolbar stays in its usual place in the DOM and is drawn over the sidebar's top area. */
+:root[folio-sidebar-toolbar] #navigator-toolbox {
+  position: fixed !important;
+  top: 0;
+  left: var(--folio-sidebar-left, 0px);
+  width: var(--folio-sidebar-width, 280px);
+  z-index: 3;
+  background: transparent !important;
+}
+:root[folio-sidebar-toolbar] sidebar-main { padding-top: var(--folio-toolbar-height, 88px) !important; }
+:root[folio-sidebar-toolbar] #nav-bar {
+  background: transparent !important;
+  border: none !important;
+  box-shadow: none !important;
+  padding: 6px 6px 4px !important;
+  min-height: 0 !important;
+  position: relative;
+  --urlbar-container-min-width: 0px;
+}
+:root[folio-sidebar-toolbar] #nav-bar-customization-target { flex-wrap: wrap !important; row-gap: 8px; padding-right: 36px; }
+/* Buttons share one row; the address bar takes the full width under them. */
+:root[folio-sidebar-toolbar] #nav-bar #urlbar-container {
+  order: 99;
+  flex: 1 0 100% !important;
+  width: auto !important;
+  max-width: none !important;
+  min-width: 0 !important;
+  margin: 0 -36px 0 0 !important;
+}
+:root[folio-sidebar-toolbar] #nav-bar toolbarspring,
+:root[folio-sidebar-toolbar] #nav-bar #vertical-spacer { display: none !important; }
+/* The menu button sits outside the button row: pin it to the row's right end. */
+:root[folio-sidebar-toolbar] #nav-bar #PanelUI-button { position: absolute; top: 6px; right: 6px; }
+/* Nothing is left above the page, so the card gets an even gap all around. */
+:root[folio-sidebar-toolbar] #tabbrowser-tabbox { margin: 8px 8px 8px 2px; }
+
+/* ---- Folio: back / forward only show when there is somewhere to go. Reload always stays. ---- */
+#back-button[disabled],
+#forward-button[disabled] { display: none !important; }
+
+/* ---- Folio: address bar at the BOTTOM of the sidebar, just above the bookmarks/history icons.
+   The button row stays at the top of the sidebar; only the address bar moves down. ---- */
+:root[folio-sidebar-toolbar-bottom] #nav-bar #urlbar-container {
+  position: fixed !important;
+  left: calc(var(--folio-sidebar-left, 0px) + 6px);
+  width: calc(var(--folio-sidebar-width, 280px) - 12px) !important;
+  /* just above the tool icons (spaces are at the top of the list now) */
+  bottom: calc(var(--folio-tools-height, 52px) + 16px);
+  margin: 0 !important;
+  flex: none !important;
+}
+:root[folio-sidebar-toolbar-bottom] #folio-sidebar-body { padding-bottom: 56px; }
+
+
+/* ---- Folio sidebar (folio-sidebar.js): our own, the only sidebar. Ctrl+S hides it ---- */
+/* Firefox's vertical-tabs sidebar and its horizontal tab strip are replaced by ours. */
+#sidebar-container, #sidebar-box, #sidebar-launcher-splitter, #sidebar-splitter { display: none !important; }
+:root:not([folio-sidebar-hidden]) #TabsToolbar { display: none !important; }
+#folio-sidebar {
+  width: 260px;
+  min-width: 220px;
+  padding: 8px 8px 10px;
+  border-inline-end: 1px solid color-mix(in srgb, currentColor 10%, transparent);
+}
+:root[folio-sidebar-hidden] #folio-sidebar { display: none; }
+/* While it slides (folio-sidebar.js setHidden): the content keeps its full width and is revealed/clipped, so nothing re-wraps. */
+:root[folio-sidebar-animating] #folio-sidebar { overflow: hidden; }
+:root[folio-sidebar-animating] #folio-sidebar-body,
+:root[folio-sidebar-animating] #folio-sidebar-bottom { min-width: calc(var(--folio-sidebar-inner, 260px) - 17px); flex-shrink: 0; }
+/* The toolbar drawn over the sidebar keeps its full width too and is clipped to the sidebar's current width. */
+:root[folio-sidebar-animating][folio-sidebar-toolbar] #navigator-toolbox {
+  width: var(--folio-sidebar-inner, 280px) !important;
+  clip-path: inset(0 max(0px, calc(var(--folio-sidebar-inner, 280px) - var(--folio-sidebar-width, 280px))) 0 0);
+}
+:root[folio-sidebar-animating][folio-sidebar-toolbar-bottom] #nav-bar #urlbar-container {
+  width: calc(var(--folio-sidebar-inner, 280px) - 12px) !important;
+  clip-path: inset(0 max(0px, calc(var(--folio-sidebar-inner, 280px) - var(--folio-sidebar-width, 280px))) 0 0);
+}
+.folio-side-row { align-items: center; gap: 2px; }
+#folio-sidebar-top { justify-content: space-between; padding-bottom: 8px; }
