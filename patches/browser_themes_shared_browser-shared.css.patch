+/* ---- Folio: sound indicator in the tab row (folio-sidebar.js makeRow/updateRow) ---- */
+#folio-sidebar .folio-side-tab > .folio-side-tab-audio {
+  display: none; appearance: none; flex: none;
+  width: 22px; height: 22px; min-width: 22px; padding: 3px; margin: 0 2px 0 0;
+  border: none; border-radius: 6px; background: transparent center / 14px no-repeat;
+  -moz-context-properties: fill; fill: var(--folio-muted); color: var(--folio-muted); cursor: pointer;
+}
+#folio-sidebar .folio-side-tab > .folio-side-tab-audio:hover { background-color: var(--folio-surface); fill: var(--folio-text); }
+#folio-sidebar .folio-side-tab:is([soundplaying], [muted], [activemedia-blocked]) > .folio-side-tab-audio { display: flex; }
+#folio-sidebar .folio-side-tab[soundplaying] > .folio-side-tab-audio { background-image: url("chrome://browser/skin/tabbrowser/tab-audio-playing-small.svg"); fill: var(--folio-accent); }
+#folio-sidebar .folio-side-tab[muted] > .folio-side-tab-audio { background-image: url("chrome://browser/skin/tabbrowser/tab-audio-muted-small.svg"); fill: var(--folio-muted); }
