+.folio-ess-tile:hover .folio-ess-badge { opacity: 0; }
+/* Window buttons in the sidebar layout (floating desktops only): their own slim row on top, so the button row and the
+   full-width address bar below keep their layout. Side follows the desktop's button layout (GTK decoration-layout). */
+:root:not([folio-tiling])[folio-sidebar-toolbar] #nav-bar { flex-wrap: wrap !important; }
+:root:not([folio-tiling])[folio-sidebar-toolbar] #nav-bar > .titlebar-buttonbox-container {
