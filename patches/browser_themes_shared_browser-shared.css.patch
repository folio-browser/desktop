+:root:not([lwtheme]), :root:not([lwtheme]) :is(panel, menupopup) {
+  --color-accent-primary: var(--folio-accent);
+  --color-accent-primary-hover: color-mix(in srgb, white 12%, var(--folio-accent));
+  --color-accent-primary-active: color-mix(in srgb, black 12%, var(--folio-accent));
