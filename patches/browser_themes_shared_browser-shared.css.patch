+:root:is([folio-wallpaper], [folio-seethrough]) #folio-empty { color: #fff; }
+:root:is([folio-wallpaper], [folio-seethrough]) #folio-empty .folio-empty-title { text-shadow: 0 1px 2px rgba(0, 0, 0, .35), 0 4px 24px rgba(0, 0, 0, .25); }
+#folio-empty .folio-dl-btn { margin-top: 6px; padding: 8px 18px; border-radius: 999px; font-size: 14px; font-weight: 600; border: 1px solid rgba(255, 255, 255, .2);
+  background: linear-gradient(180deg, rgba(255, 255, 255, .14), rgba(255, 255, 255, .05)); color: inherit;
+  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .25), 0 10px 34px rgba(0, 0, 0, .28); }
+#folio-empty .folio-dl-btn:hover { background: color-mix(in srgb, var(--folio-accent) 35%, rgba(255, 255, 255, .08)); }
+
+/* Error pages (folio-zen.js watchErrorPages): the wallpaper behind them, lined up with the window's, under a light dark
+   veil so their small text reads. In see-through mode nothing is painted (the window shows through). */
+:root[folio-wallpaper]:not([folio-seethrough]) .browserContainer[folio-errorpage] {
+  background: linear-gradient(rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0.28)), var(--folio-wallpaper) center / cover fixed !important;
+}
+
+/* See-through colors (2026-11-26): the glass is tinted with the DESKTOP wallpaper's colors (FolioTheme.applyDesktop sets
+   --folio-sidebar-bg / --folio-accent from it), dark or a white frost in light mode, instead of a fixed near-black. */
+:root[folio-seethrough] { --folio-st-base: var(--folio-sidebar-bg, #0b0b10); }
+:root[folio-seethrough][folio-light] { --folio-st-base: var(--folio-sidebar-bg, #f4f3f8); }
+
+/* ≡ in the floating sidebar's bottom row (folio-sidebar.js #folio-side-menu): only in the peek, where the real menu
+   button stays up in the top bar. Same size and look as the other bottom buttons. */
+#folio-side-menu { display: none !important; }
+:root[folio-sidebar-hidden][folio-peek] #folio-sidebar #folio-side-menu { display: flex !important; order: 99; margin-inline-start: 4px; }
+#folio-side-menu > .toolbarbutton-icon {
+  list-style-image: none !important; width: 16px; height: 16px; padding: 0 !important;
+  background-color: currentColor; mask: url("chrome://browser/skin/menu.svg") center / 16px no-repeat;
+}
+#folio-side-menu > .toolbarbutton-text { display: none; }
+
+/* Sammy (2026-11-26): the Zen button takes the bookmark star's place in the address bar. Bookmarking stays on Ctrl+D
+   and in the menu. (The Zen button shows on websites; Folio's own pages have nothing to Zen.) */
+#star-button-box { display: none !important; }
+
+/* Sammy (2026-11-26): no copy-link button in the address bar; only the Zen lotus (in the star's place). */
+#folio-copy-button { display: none !important; }
