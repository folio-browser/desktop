+#folio-side-downloads[folio-dl-active]::before {
+  content: ""; position: absolute; inset: 1px; border-radius: 50%; pointer-events: none;
+  background: conic-gradient(var(--folio-accent) var(--folio-dl-progress, 0%), color-mix(in srgb, var(--folio-accent) 18%, transparent) 0);
+  mask: radial-gradient(farthest-side, transparent calc(100% - 2.5px), #000 calc(100% - 2px));
