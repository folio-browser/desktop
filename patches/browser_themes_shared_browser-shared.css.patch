+  display: flex !important;
+  position: fixed !important;
+  left: 8px; top: var(--folio-peek-top, 8px); bottom: 8px; /* Helium kZenModeVTSPadding = 8 */
+  width: var(--folio-peek-w, 260px) !important;
+  z-index: 31;
+  opacity: 1; /* not !important: an !important value beats the slide's animated opacity */
+  border: 1px solid rgb(var(--folio-ink, 255 255 255) / 0.08) !important;
