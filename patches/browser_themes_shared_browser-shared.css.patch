+/* ---- Folio sidebar views (History, Downloads) inside the sidebar. Colors are tokens for the theme editor. ---- */
+:root {
+  --folio-accent: #7aa2f7;
+  --folio-accent-soft: color-mix(in srgb, var(--folio-accent) 22%, transparent);
