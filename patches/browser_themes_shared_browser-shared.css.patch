+.folio-side-tab-audio > .toolbarbutton-icon, .folio-side-tab-audio > .toolbarbutton-text { display: none; }
+/* Unread count on an Essential (from its open tab's title). */
+.folio-ess-badge {
+  position: absolute; top: 4px; right: 4px; min-width: 16px; height: 16px; padding: 0 4px; box-sizing: border-box;
+  border-radius: 8px; background: var(--folio-accent); color: #15121f;
