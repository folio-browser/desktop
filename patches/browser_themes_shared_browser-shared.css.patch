+/* ---- Folio: LIGHT mode (2026-11-24, Sammy: "I switched to light and our sidebar was still dark") ----
+   Folio follows the Appearance choice in Settings (website appearance Light / Dark / System; System = the desktop).
+   folio-sidebar.js FolioScheme sets [folio-light] on the window. A wallpaper theme keeps its own palette (its inline
+   colors win). Hard-coded white tints in Folio's CSS go through --folio-ink (white on dark, black on light). */
+:root { --folio-ink: 255 255 255; --folio-scheme: dark; }
+:root[folio-light] {
+  --folio-ink: 0 0 0;
+  --folio-scheme: light;
+  --folio-frame: #e6e5ec;
+  --folio-sidebar-bg: #efeef4;
+  --folio-panel-bg: #ffffff;
+  --folio-text: #1c1a23;
+  --folio-muted: rgba(28, 26, 35, 0.58);
+  --folio-surface: rgba(0, 0, 0, 0.055);
+  --folio-grid: rgba(0, 0, 0, 0.09);
+  --folio-accent-soft: color-mix(in srgb, var(--folio-accent) 20%, transparent);
+  --folio-empty-bg: #f7f6fa;
+}
+/* The frame's text and icons (fill: currentColor) follow Folio's palette in both modes, whatever the desktop's
+   GTK colors say. */
+:root:not([lwtheme]) :is(#navigator-toolbox, #folio-sidebar) {
+  color: var(--folio-text) !important;
+  --toolbar-field-color: var(--folio-text);
+  --toolbar-field-focus-color: var(--folio-text);
+}
+:root[folio-light]:not([lwtheme]) #urlbar-background { background-color: rgba(0, 0, 0, 0.055) !important; }
+:root[folio-light]:not([lwtheme]) #urlbar[open] > #urlbar-background,
+:root[folio-light]:not([lwtheme]) #urlbar[focused] > #urlbar-background { background-color: #ffffff !important; }
