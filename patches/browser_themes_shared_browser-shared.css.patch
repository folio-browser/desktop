+.folio-side-tab[busy] > .folio-side-tab-icon { display: none; }
+.folio-side-tab[busy] > .folio-side-tab-spinner {
+  display: flex; flex: none; box-sizing: border-box;
+  width: 14px; height: 14px; margin: 1px;
