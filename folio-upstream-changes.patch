+  *aGenerichide = false;
+  if (!IsInitialized()) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  MutexAutoLock lock(mLock);
+  auto entry = mEngines.Lookup("test_block"_ns);
+  if (!entry || !entry.Data()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  return entry.Data()->CosmeticResources(aUrl, aHide, aExceptions, aScript,
+                                         aGenerichide);
