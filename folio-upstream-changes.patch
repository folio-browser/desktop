+/* static */
+bool gfxPlatformFontList::IsFarbledOutFamily(FontVisibilityProvider* aProvider,
+                                             FontVisibility aFamilyVisibility,
+                                             const nsACString& aFamilyKey) {
+  if (!aProvider || aFamilyVisibility == FontVisibility::Base ||
+      aFamilyVisibility == FontVisibility::Hidden) {
+    return false;
+  }
+  uint64_t seed = aProvider->GetFontFarbleSeed();
+  if (!seed) {
+    return false;
+  }
+  // Common OS font families stay visible (they are the same on millions of machines, and sites rely on them).
+  static const char* const kKeep[] = {"dejavu", "liberation", "noto", "cantarell", "adwaita", "symbola"};
+  for (const char* prefix : kKeep) {
+    if (StringBeginsWith(aFamilyKey, nsDependentCString(prefix))) {
+      return false;
+    }
+  }
+  uint64_t h = seed ^ (uint64_t(HashString(aFamilyKey)) * 0x9E3779B97F4A7C15ULL);
+  h ^= h >> 33; h *= 0xff51afd7ed558ccdULL; h ^= h >> 33;
+  return (h & 1) != 0;  // about half of the other fonts, different for every site and every session
+}
