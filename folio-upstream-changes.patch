+
+NS_IMETHODIMP ContentClassifierService::FolioCosmetic(const nsACString& aUrl,
+                                                      nsACString& aHide,
+                                                      nsACString& aExceptions,
+                                                      nsACString& aScript,
+                                                      bool* aGenerichide) {
